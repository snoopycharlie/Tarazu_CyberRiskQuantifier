# ──────────────────────────────────────────────────────────────────────────────
# Tarazu — CyberRiskQuant  |  Environment Variables Template
# ──────────────────────────────────────────────────────────────────────────────
# 1. Copy this file to .env:    cp .env.example .env
# 2. Fill in your values below.
# 3. The app runs fully in deterministic rules-only mode when GROQ_API_KEY is
#    blank — you do NOT need a key to start. Add it when ready for AI narratives.
# ──────────────────────────────────────────────────────────────────────────────

# ── Groq AI (Optional — app works without this in rules-only mode) ───────────
# Get your key at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Database ──────────────────────────────────────────────────────────────────
# Docker Compose sets this automatically. For local dev (no Docker) leave blank
# to auto-use SQLite at ./tarazu.db
DATABASE_URL=postgresql+asyncpg://tarazu:tarazu@localhost:5432/tarazu

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Access control ──────────────────────────────────────────────────────────
# Production: each key is scoped to its permitted organization UUIDs. Use ["*"]
# only for a trusted administrator key. The frontend proxy uses API_PROXY_KEY.
AUTH_REQUIRED=true
API_PROXY_KEY=replace-with-a-long-random-secret
API_KEY_TENANTS={"replace-with-a-long-random-secret":["*"]}
# Local development only: set AUTH_REQUIRED=false, or add VITE_API_KEY to
# frontend/.env.local using a configured key.

# ── NVD CVE API ───────────────────────────────────────────────────────────────
# Free to use at low volume — no key needed. Rate limited at 5 req/30s.
NVD_API_BASE=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_TIMEOUT=15

# ── Feature Flags ─────────────────────────────────────────────────────────────
SEED_ON_STARTUP=true
